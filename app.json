{
  "expo": {
    "name": "pomodoro-timer",
    "slug": "pomodoro-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#005028"
    },
    "ios": {
      "supportsTablet": true,
      "icon": {
        "dark": "./assets/ios-icon-dark.png",
        "light": "./assets/ios-icon-default.png",
        "tinted": "./assets/ios-icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#062013"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gmaximo13.pomodorotimer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#062013",
          "image": "./assets/splash-icon-ios.png",
          "dark": {
            "image": "./assets/splash-icon-ios.png",
            "backgroundColor": "#062013"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "96dbe9cb-14ad-4fbc-8110-2ab1141acadb"
      }
    }
  }
}
